# 실제 값은 여기에 적지 않는다. `.env.local` 에 넣거나 시크릿 매니저에서 읽는다.
# `.env*` 는 .gitignore 에 있어 커밋되지 않는다.

# ─── 대시보드만 띄우려면 이 셋이면 된다 ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=<REPLACE_WITH_SECRET_MANAGER>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<REPLACE_WITH_SECRET_MANAGER>
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_WITH_SECRET_MANAGER>

# ─── Riot 수집을 테스트할 때만 ───────────────────────────────────────────────
# RIOT_ROUTING / RIOT_REGION 은 환경변수로 읽지 않는다. src/lib/config.ts 의 상수다.
RIOT_API_KEY=<REPLACE_WITH_SECRET_MANAGER>

# ─── 동기화 경로 인증 ────────────────────────────────────────────────────────
# SYNC_SECRET: GET /api/sync 의 x-sync-secret 헤더.
#   GitHub Actions 시크릿과 Vercel 환경변수에 **같은 값**이어야 한다.
#   한쪽만 바꾸면 매시간 동기화가 401 로 죽는다.
SYNC_SECRET=<REPLACE_WITH_SECRET_MANAGER>

# LCU_SYNC_SECRET: POST /api/lcu-sync 의 body secret,
#   그리고 /api/recalculate-scores · /api/debug 의 x-lcu-sync-secret 헤더.
#   Windows PC 에서는 OS 환경변수에 있어 .env.local 에 안 넣어도 Next 가 읽는다.
LCU_SYNC_SECRET=<REPLACE_WITH_SECRET_MANAGER>
